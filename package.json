{
  "name": "asclepia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "fix": "eslint --fix . && prettier --write .",
    "lint": "eslint --max-warnings=0 .",
    "format:check": "prettier --check .",
    "type-check": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "guards": "bash scripts/guards/run-all.sh",
    "guards:selftest": "bash scripts/guards/selftest.sh",
    "check": "pnpm lint && pnpm format:check && pnpm type-check && pnpm depcruise && pnpm guards:selftest && pnpm guards && pnpm test && pnpm build",
    "postinstall": "prisma generate",
    "db:setup": "bash scripts/db/setup.sh",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "antd": "^6.6.7",
    "next": "16.4.3",
    "next-auth": "4.24.15",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.7.0",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "testcontainers": "^12.2.1",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.32.1"
}
