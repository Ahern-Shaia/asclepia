# Copy to .env and fill in. Never commit real values (CLAUDE.md R3). Schema: src/server/env.ts.

# Local database (compose.yaml, `pnpm db:setup`). Generate each password with: openssl rand -hex 24
DB_OWNER_PASSWORD=""
DB_APP_PASSWORD=""
# The app connects as the low-privilege role; migrations use the owner (stack-rules S5-5).
DATABASE_URL="postgresql://asclepia_app:<DB_APP_PASSWORD>@localhost:54329/asclepia"
MIGRATE_DATABASE_URL="postgresql://asclepia_owner:<DB_OWNER_PASSWORD>@localhost:54329/asclepia"
# Pool sizing check (stack-rules P5-2): DB_POOL_MAX × DEPLOY_MAX_INSTANCES + reserved < max.
# DB_POOL_MAX="5"
# DEPLOY_MAX_INSTANCES="1"
# DB_MAX_CONNECTIONS="100"

# Back-office login (Google OAuth). NEXTAUTH_SECRET: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3200"  # dev port (pnpm dev); :3000 is taken on this machine
NEXTAUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Comma-separated Google accounts allowed into /admin (OQ-CAT-6)
ADMIN_EMAILS=""
